
# --- DB 접속 (data_preprocessing.data_fetch) — 전부 필수, DB_PORT만 기본값 3306 ---
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- 백엔드 연동 (api.config) ---
# 예측 결과를 push할 백엔드 주소. 기본값 http://localhost:8080은 로컬 개발용이라
# 배포 환경에서는 반드시 실제 백엔드 주소로 override 해야 함.
BACKEND_BASE_URL=http://localhost:8080
# 내부 API 간 접근 제어 토큰. 협의된 방식이 없으면 비워둬도 동작(헤더 없이 호출).
INTERNAL_AI_TOKEN=
# 백엔드 호출 타임아웃(초). 기본 10.
BACKEND_REQUEST_TIMEOUT_SECONDS=10
# 추천 결과 TTL(시간). 기본 24.
RECOMMENDATION_TTL_HOURS=24

# --- 모델 아티팩트 경로 (api.config) ---
# Dockerfile에서 이미 /app/model/artifacts로 ENV 설정되어 있어 컨테이너 기본값으로 충분.
# 볼륨/외부 스토리지로 마운트하는 경로가 바뀌는 경우에만 override.
MODEL_ARTIFACT_DIR=/app/model/artifacts
